<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/campusai/db" VERSION="20260801" COMMENT="XMLDB file for local_campusai plugin."
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>

    <TABLE NAME="local_campusai_conversation" COMMENT="Stores student interactions for audit.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who sent the message"/>
        <FIELD NAME="usermessage" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Question from the student"/>
        <FIELD NAME="assistantmessage" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Response from the assistant"/>
        <FIELD NAME="functionscalled" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of functions called"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="AI provider used"/>
        <FIELD NAME="tokensused" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="userid_time" UNIQUE="false" FIELDS="userid, timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_campusai_ratelimit" COMMENT="Rate limiting tracking.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp of rate window start"/>
        <FIELD NAME="messagecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_window" UNIQUE="true" FIELDS="userid, windowstart"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
