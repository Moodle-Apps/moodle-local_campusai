<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/campusai/db" VERSION="20260901" COMMENT="XMLDB file for Moodle local/campusai"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_campusai_conversation" COMMENT="Stores each turn of the conversation for audit and privacy.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Foreign key to user.id"/>
        <FIELD NAME="usermessage" TYPE="text" NOTNULL="true" COMMENT="User question"/>
        <FIELD NAME="assistantmessage" TYPE="text" NOTNULL="true" COMMENT="Assistant reply"/>
        <FIELD NAME="functionscalled" TYPE="text" NOTNULL="false" COMMENT="JSON array of functions called"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="30" NOTNULL="true" COMMENT="Provider used"/>
        <FIELD NAME="tokensused" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Approximate token cost"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="userid_time" UNIQUE="false" FIELDS="userid, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_campusai_ratelimit" COMMENT="Rate limiting counters per user.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Foreign key to user.id"/>
        <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Start of the window (Unix timestamp)"/>
        <FIELD NAME="messagecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Message counter"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_window" UNIQUE="true" FIELDS="userid, windowstart"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
